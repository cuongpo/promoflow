# ==============================================================================
# PromoFlow Environment Configuration (Gemini & Veo 3)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Key (required for Live AI mode with Gemini & Veo 3)
# ------------------------------------------------------------------------------
SHOPAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Base URL (optional override)
# ------------------------------------------------------------------------------
# SHOPAI_BASE_URL=https://api.shopaikey.com/v1

# ------------------------------------------------------------------------------
# 3. Model for each pipeline step (control individual steps)
# ------------------------------------------------------------------------------
# Step 1: Format Extractor (watches reference YouTube Short and extracts beats JSON)
FORMAT_MODEL=gemini-2.5-flash

# Step 2: Script Writer (generates full video script: hook, twist, steps, payoff, CTA)
SCRIPT_MODEL=gemini-2.5-flash

# Step 3: Hooks Generator (generates 4 alternative opening hooks)
HOOKS_MODEL=gemini-2.5-flash

# Step 4: Hook Clip / Video Generator (generates vertical UGC hook video via Veo 3.1)
VEO_MODEL=veo3.1-fast

# ------------------------------------------------------------------------------
# 4. Global Fallback Model (optional)
# ------------------------------------------------------------------------------
# SHOPAI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. UI Controls
# ------------------------------------------------------------------------------
# Set to 'true' to show the API key input box on the landing page, or 'false' to hide it
SHOW_API_KEY_INPUT=false
